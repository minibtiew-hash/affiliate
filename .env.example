# Nano Banana 2 (Gemini image generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image

# Kling (image2video animation)
KLING_API_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
# kling-v2-6, no native audio, confirmed from kling.ai/document-api/pricing:
# pro mode $0.07/s, std mode $0.042/s. Native audio roughly doubles either —
# update if component #9 (audio) flips sound="on".
KLING_COST_PER_SECOND_USD_PRO=0.07
KLING_COST_PER_SECOND_USD_STD=0.042

# Google Cloud Storage (hosts generated images at a URL Kling can fetch)
# Also requires GOOGLE_APPLICATION_CREDENTIALS to point at a service account
# key JSON file with Storage Object Admin on this bucket (plain
# `gcloud auth login` user credentials generally can't sign URLs).
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
GCS_SIGNED_URL_EXPIRATION_SECONDS=3600
